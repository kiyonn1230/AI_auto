# --- Supabase（ダッシュボード / 予約フォーム / 予約管理画面で共通）---
# Supabase プロジェクトの Settings → API からコピーして .env.local に貼り付けてください。
# NEXT_PUBLIC_ の付いた値はビルド時に埋め込まれるため、変更したら再ビルド（再デプロイ）が必要です。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- 予約の管理画面（/admin/reservations）用 ---
# service_role キー（Settings → API の「service_role」）。RLS を無視して全予約を読み書きできる鍵です。
# サーバー側でしか使いません。絶対に NEXT_PUBLIC_ を付けないこと（付けるとブラウザに配信されます）。
SUPABASE_SERVICE_ROLE_KEY=

# 管理画面の Basic 認証。どちらかが空のあいだは管理画面を開けません（安全側に倒しています）。
# パスワードは推測されにくい長いものに。例: openssl rand -base64 24
ADMIN_USER=
ADMIN_PASSWORD=

# --- 保護者レポート作成（/report）用 ---
# https://console.anthropic.com/ で発行したキー。サーバー側でのみ使うので NEXT_PUBLIC_ は付けません
ANTHROPIC_API_KEY=sk-ant-...
