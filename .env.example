# --- ダッシュボード（/）用 ---
# Supabase プロジェクトの Settings → API からコピーして .env.local に貼り付けてください
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- 保護者レポート作成（/report）用 ---
# https://console.anthropic.com/ で発行したキー。サーバー側でのみ使うので NEXT_PUBLIC_ は付けません
ANTHROPIC_API_KEY=sk-ant-...
